@model DiplomaProject_ITMO.Models.FeedbackModel

@{
    ViewData["Title"] = "Обратная связь";
}

<style>
    html,
    body {
        height: auto;
        margin: 0;
        font-family: 'Roboto', sans-serif;
    }

    .background-container {
        background-image: url('/images/home1.jpg');
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        height: 100vh;
        width: 100%;
        position: fixed;
        top: 0;
        left: 0;
        z-index: -1;
        filter: brightness(1.2);
    }

    .content {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 20px;
    }

    .card {
        background-color: rgba(255, 255, 255, 0.8);
        color: #333;
        border: none;
        box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.2);
        width: 80%;
        max-width: 800px;
        padding: 20px;
    }

    .card-title {
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 1rem;
        text-align: center;
    }

    .card-text {
        font-size: 1.2rem;
        margin-bottom: 1rem;
        text-align: left;
    }

    /* Стили для формы отзывов/контактов (если есть) */
    .form-group {
        margin-bottom: 1rem;
    }

    label {
        display: block;
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
    }

    input[type="email"],
    textarea {
        width: 100%;
        padding: 0.5rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 1rem;
        margin-bottom: 1rem;
        font-family: 'Roboto', sans-serif;
    }

    textarea {
        resize: vertical;
    }

    .submit-button {
        background-color: orange;
        border-color: orange;
        color: white;
        padding: 0.75rem 1.5rem;
        font-size: 1.1rem;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.2s ease-in-out;
        margin-top: 1rem;
        border: none;
    }

        .submit-button:hover {
            background-color: #cc7a00;
        }

    .success-message {
        margin-top: 1rem;
        padding: 0.75rem;
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
        border-radius: 4px;
    }
</style>

<div class="background-container"></div>
<div class="content">
    <div class="card">
        <div class="card-body">
            <h1 class="card-title">Обратная связь</h1>

            <form method="post" asp-controller="Feedback" asp-action="Submit" class="feedback-form">
                <div class="form-group">
                    <label for="email">Ваш емейл:</label>
                    <input type="email" id="email" name="Email" class="form-control" required />
                </div>

                <div class="form-group">
                    <label for="message">Ваше сообщение:</label>
                    <textarea id="message" name="Message" class="form-control" rows="4" required></textarea>
                </div>

                <button type="submit" class="submit-button">Отправить</button>
            </form>

            @if (ViewData["SuccessMessage"] != null)
            {
                <p class="success-message">@ViewData["SuccessMessage"]</p>
            }
        </div>
    </div>
</div>