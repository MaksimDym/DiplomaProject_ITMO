@model DiplomaProject_ITMO.Models.FeedbackModel

@{
    ViewData["Title"] = "Обратная связь";
}

<div id="feedback-page-content">
    
    <div class="background-container"></div>
    <div class="content">
        <div class="card">
            <div class="card-body">
                <h1 class="card-title">Обратная связь</h1>

                <form method="post" asp-controller="Feedback" asp-action="Submit" class="feedback-form">
                    <div class="form-group">
                        <label for="email">Ваш емейл:</label>
                        <input type="email" id="email" name="Email" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label for="message">Ваше сообщение:</label>
                        <textarea id="message" name="Message" class="form-control" rows="4" required></textarea>
                    </div>

                    <button type="submit" class="submit-button">Отправить</button>
                </form>

                @if (ViewData["SuccessMessage"] != null)
                {
                    <p class="success-message">@ViewData["SuccessMessage"]</p>
                }
            </div>
        </div>
    </div>
</div>