@{
    ViewData["Title"] = "Главная";
}

@using Microsoft.AspNetCore.Http  // Добавьте это для работы с Session

<div class="background-container"></div>
<div class="content">
    <div class="card">
        <div class="card-body">
            <h1 class="card-title text-center">
                Расчёт строительства индивидуального дома
            </h1>
            <p class="card-text">
                Этот сайт поможет вам рассчитать стоимость материалов для
                строительства, рассчитать дополнительные услуги и оставить обратную
                связь. С нами вы сможете спланировать свой проект и получить точную
                оценку затрат.
            </p>
            <p class="card-text">Мы предлагаем:</p>
            <ul>
                <li class="list-item">Точные расчеты стоимости материалов.</li>
                <li class="list-item">
                    Оценку дополнительных услуг (сауна, забор, электричество,
                    водопровод).
                </li>
                <li class="list-item">Возможность оставить отзыв и предложения.</li>
            </ul>
            <p class="card-text last-paragraph">
                Начните планировать свой дом мечты сегодня!
            </p>

            @if (Context.Session.GetString("username") == null)
            {
                
                <a asp-action="Login" asp-controller="Account" class="btn btn-primary">Авторизация</a>
            }
            else
            {
                
                <p>Добро пожаловать, @Context.Session.GetString("username")!</p>
                <a asp-action="Logout" asp-controller="Account" class="btn btn-secondary">Выход</a>
            }
        </div>
    </div>
</div>
