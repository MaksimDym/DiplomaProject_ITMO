<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DiplomaProject_ITMO.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-dark text-white">
            <div class="container">
               
                <a class="navbar-brand" href="#"></a> <!-- Можно убрать, если не нужен логотип -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav justify-content-center">
                        <li class="nav-item mx-3">
                            <!-- Добавлен mx-3 -->
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Главная</a>
                        </li>
                        <li class="nav-item mx-3">
                            <!-- Добавлен mx-3 -->
                            <a class="nav-link text-white" asp-area="" asp-controller="Calculate" asp-action="Index">Расчет материалов</a>
                        </li>
                        <li class="nav-item mx-3">
                            
                            <a class="nav-link text-white" asp-area="" asp-controller="Feedback" asp-action="Index">Обратная связь</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container body-content">
        @RenderBody()
       
       
    </div>
    <footer class="border-top footer my-dark-footer" style="position: fixed; bottom: 0; width: 100%; height: 40px; line-height: 40px;">
        <div class="container text-center">
            &copy; 2025 - DiplomaProject_ITMO - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-light">Политика конфиденциальности</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>